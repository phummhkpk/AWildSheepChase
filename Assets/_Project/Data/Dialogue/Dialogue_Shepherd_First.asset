    giveItem: {fileID: 0}
    giveAmount: 0
    completesDialogue: 0
    conditionItem: {fileID: 0}
    conditionAmount: 1
    invertCondition: 0
  - speaker: Old Shepherd
    text: Bless you. Take this potion.
